<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.otplesssdk.otp" >

    <uses-sdk android:minSdkVersion="21" />

    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application>
        <receiver
            android:name="com.otplesssdk.otp.receiver.SmsRetrieverReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="com.google.android.gms.auth.api.phone.permission.SEND" >
            <intent-filter>
                <action android:name="com.google.android.gms.auth.api.phone.SMS_RETRIEVED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.otplesssdk.otp.receiver.WhatsAppOtpReceiver"
            android:enabled="true"
            android:exported="true" >
            <intent-filter>
                <action android:name="com.whatsapp.otp.OTP_RETRIEVED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.otplesssdk.otp.receiver.WhatsAppOtpErrorReceiver"
            android:enabled="true"
            android:exported="true" >
            <intent-filter>
                <action android:name="com.whatsapp.otp.OTP_ERROR" />
            </intent-filter>
        </receiver>
    </application>

</manifest>